#!/usr/bin/env bash
# Install/upgrade kOMA Launcher from this folder and restart plasmashell
# (through its systemd user service, so the session keeps managing it).
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
# install only what `make package` ships (plus files not yet committed), never dev tooling
pkg=$(mktemp -d)
trap 'rm -rf "$pkg"' EXIT
(cd "$dir" && git ls-files -z --cached --others --exclude-standard -- metadata.json contents LICENSE |
  while IFS= read -r -d "" f; do if [ -e "$f" ]; then cp --parents "$f" "$pkg"; fi; done)
kpackagetool6 --type Plasma/Applet --upgrade "$pkg" >/dev/null 2>&1 ||
  kpackagetool6 --type Plasma/Applet --install "$pkg"
systemctl --user restart plasma-plasmashell.service
